-- =========================================================================
-- 11. CONSULTAS DEMONSTRATIVAS DAS FORMAS NORMAIS (DQL)
-- =========================================================================

-- -------------------------------------------------------------------------
-- DEMONSTRAÇÃO DA 1FN: Consultando os e-mails cadastrados do Produtor
-- -------------------------------------------------------------------------
SELECT 
    p.nome AS 'Produtor',
    e.email AS 'E-mail Cadastrado'
FROM Produtor p
INNER JOIN ProdutorEmail e ON p.idProdutor = e.idProdutor
WHERE p.idProdutor = 1;

-- -------------------------------------------------------------------------
-- DEMONSTRAÇÃO DA 2FN E 3FN: Detalhamento das Entregas de Cana por Usina
-- -------------------------------------------------------------------------
SELECT 
    e.idEntrega AS 'Nº Entrega',
    e.dataEntrega AS 'Data',
    p.nome AS 'Produtor',
    u.nomeUsina AS 'Usina Conveniada',
    e.toneladas AS 'Toneladas',
    e.valorPago AS 'Valor Total (R$)'
FROM EntregaCana e
INNER JOIN Produtor p ON e.idProdutor = p.idProdutor
INNER JOIN Usina u ON e.idUsina = u.idUsina
ORDER BY e.dataEntrega;

-- -------------------------------------------------------------------------
-- DEMONSTRAÇÃO DE COMPRA DE INSUMOS (Itens por Compra)
-- -------------------------------------------------------------------------
SELECT 
    c.idCompra AS 'Nº Compra',
    c.dataCompra AS 'Data',
    p.nome AS 'Produtor',
    i.nomeInsumo AS 'Insumo',
    item.quantidade AS 'Qtd',
    item.precoPraticado AS 'Preço Un. (R$)',
    (item.quantidade * item.precoPraticado) AS 'Subtotal (R$)'
FROM CompraInsumo c
INNER JOIN Produtor p ON c.idProdutor = p.idProdutor
INNER JOIN ItemCompraInsumo item ON c.idCompra = item.idCompra
INNER JOIN Insumo i ON item.idInsumo = i.idInsumo
ORDER BY c.idCompra;

-- -------------------------------------------------------------------------
-- DEMONSTRAÇÃO DE VISITAS TÉCNICAS REALIZADAS POR AGRÔNOMOS
-- -------------------------------------------------------------------------
SELECT 
    v.dataVisita AS 'Data da Visita',
    a.nome AS 'Agrônomo Responsável',
    p.nome AS 'Produtor Atendido',
    v.observacoes AS 'Diagnóstico',
    v.recomendacoes AS 'Recomendações'
FROM VisitaTecnica v
INNER JOIN Agronomo a ON v.idAgronomo = a.idAgronomo
INNER JOIN Produtor p ON v.idProdutor = p.idProdutor
ORDER BY v.dataVisita DESC;
