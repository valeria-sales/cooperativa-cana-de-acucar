-- =========================================================================
-- AULA PRÁTICA: NORMALIZAÇÃO DE DADOS (1FN, 2FN e 3FN) E MAPEAMENTO DER->SQL
-- Contexto: Cooperativa de Cana-de-Açúcar
-- =========================================================================

-- Criação e seleção do banco de dados
CREATE DATABASE CooperativaCanaDB;
USE CooperativaCanaDB;

-- =========================================================================
-- CONCEITO DE NORMALIZAÇÃO DE DADOS
-- "A chave, toda a chave, e nada além da chave!"
-- =========================================================================

-- =========================================================================
-- 1. TABELA PRODUTOR (Aplicando 1FN e 3FN)
--
-- APLICAÇÃO DA 1ª FORMA NORMAL (1FN - ATOMICIDADE):
-- 1. Atributo Composto (Endereço): Desmembrado em logradouro, numero, bairro, 
--    cidade, uf e cep.
-- 2. Atributo Multivalorado (E-mail): Um produtor pode ter múltiplos e-mails. 
--    O e-mail foi isolado na tabela 'ProdutorEmail' para evitar colunas repetidas.
-- =========================================================================
CREATE TABLE Produtor (
    idProdutor INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    cpf VARCHAR(14) NOT NULL UNIQUE,
    telefone VARCHAR(20),
    
    -- ATRIBUTO COMPOSTO (ENDEREÇO) DESMEMBRADO (1FN)
    logradouro VARCHAR(150) NOT NULL,
    numero VARCHAR(10) NOT NULL,
    bairro VARCHAR(60) NOT NULL,
    cidade VARCHAR(60) NOT NULL,
    uf CHAR(2) NOT NULL,
    cep CHAR(8) NOT NULL,
    dataAssociacao DATE NOT NULL
);

-- =========================================================================
-- 1.1 TABELA PRODUTOR_EMAIL (Solução da 1FN para Atributo Multivalorado)
-- =========================================================================
CREATE TABLE ProdutorEmail (
    idProdutor INT UNSIGNED NOT NULL,
    email VARCHAR(100) NOT NULL,

    -- Chave Primária Composta
    PRIMARY KEY (idProdutor, email),

    -- Chave Estrangeira com Integridade Referencial
    CONSTRAINT fk_produtor_email
        FOREIGN KEY (idProdutor)
        REFERENCES Produtor(idProdutor)
        ON DELETE CASCADE
);

-- =========================================================================
-- 2. TABELA USINA (Usinas Conveniadas)
-- =========================================================================
CREATE TABLE Usina (
    idUsina INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    nomeUsina VARCHAR(100) NOT NULL,
    cnpj VARCHAR(18) NOT NULL UNIQUE,
    cidade VARCHAR(60) NOT NULL,
    uf CHAR(2) NOT NULL
);

-- =========================================================================
-- 3. TABELA ENTREGA_CANA (Registros de Entregas)
-- =========================================================================
CREATE TABLE EntregaCana (
    idEntrega INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    dataEntrega DATE NOT NULL,
    toneladas DECIMAL(10,2) NOT NULL,
    valorPago DECIMAL(12,2) NOT NULL,
    idProdutor INT UNSIGNED NOT NULL,
    idUsina INT UNSIGNED NOT NULL,

    CONSTRAINT fk_entrega_produtor
        FOREIGN KEY (idProdutor)
        REFERENCES Produtor(idProdutor),

    CONSTRAINT fk_entrega_usina
        FOREIGN KEY (idUsina)
        REFERENCES Usina(idUsina)
);

-- =========================================================================
-- 4. TABELA CONTRIBUICAO_ANUAL (Aplicando a 3FN)
--
-- APLICAÇÃO DA 3ª FORMA NORMAL (3FN):
-- Guarda o percentual cobrado e o valor total repassado pela usina/produtor 
-- referente a um ano base.
-- =========================================================================
CREATE TABLE ContribuicaoAnual (
    idContribuicao INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    anoReferencia INT NOT NULL,
    percentualAplicado DECIMAL(5,2) NOT NULL,
    valorTotalCalculado DECIMAL(10,2) NOT NULL,
    dataPagamento DATE,
    descontoEmUsina BOOLEAN DEFAULT TRUE,
    idProdutor INT UNSIGNED NOT NULL,
    idUsinaRepasse INT UNSIGNED,

    CONSTRAINT fk_contribuicao_produtor
        FOREIGN KEY (idProdutor)
        REFERENCES Produtor(idProdutor),

    CONSTRAINT fk_contribuicao_usina
        FOREIGN KEY (idUsinaRepasse)
        REFERENCES Usina(idUsina)
);

-- =========================================================================
-- 5. TABELA INSUMO (Produtos Comerciais)
-- =========================================================================
CREATE TABLE Insumo (
    idInsumo INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    nomeInsumo VARCHAR(100) NOT NULL,
    categoria VARCHAR(50) NOT NULL, -- ex: Fertilizante, Herbicide, Semente
    precoUnitario DECIMAL(10,2) NOT NULL
);

-- =========================================================================
-- 6. TABELA COMPRA_INSUMO (Cabeçalho da Venda de Insumos)
-- =========================================================================
CREATE TABLE CompraInsumo (
    idCompra INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    dataCompra DATE NOT NULL,
    idProdutor INT UNSIGNED NOT NULL,

    CONSTRAINT fk_compra_produtor
        FOREIGN KEY (idProdutor)
        REFERENCES Produtor(idProdutor)
);

-- =========================================================================
-- 7. TABELA ITEM_COMPRA_INSUMO (Aplicando a 2ª FORMA NORMAL - 2FN)
--
-- CONCEITO: Relacionamento N:M entre CompraInsumo e Insumo.
-- A Chave Primária é COMPOSTA: (idCompra, idInsumo).
--
-- APLICAÇÃO DA 2ª FORMA NORMAL (2FN):
-- 'quantidade' e 'precoPraticado' dependem da combinação de Compra e Insumo.
-- O nome do insumo permanece isolado na tabela 'Insumo'.
-- =========================================================================
CREATE TABLE ItemCompraInsumo (
    idCompra INT UNSIGNED NOT NULL,
    idInsumo INT UNSIGNED NOT NULL,
    quantidade DECIMAL(10,2) NOT NULL,
    precoPraticado DECIMAL(10,2) NOT NULL,

    -- Chave Primária Composta (2FN)
    PRIMARY KEY (idCompra, idInsumo),

    -- Chaves Estrangeiras
    CONSTRAINT fk_item_compra
        FOREIGN KEY (idCompra)
        REFERENCES CompraInsumo(idCompra),

    CONSTRAINT fk_item_insumo
        FOREIGN KEY (idInsumo)
        REFERENCES Insumo(idInsumo)
);

-- =========================================================================
-- 8. TABELA AGRONOMO
-- =========================================================================
CREATE TABLE Agronomo (
    idAgronomo INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    crea VARCHAR(20) NOT NULL UNIQUE
);

-- =========================================================================
-- 9. TABELA VISITA_TECNICA
-- =========================================================================
CREATE TABLE VisitaTecnica (
    idVisita INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    dataVisita DATE NOT NULL,
    observacoes TEXT,
    recomendacoes TEXT,
    idProdutor INT UNSIGNED NOT NULL,
    idAgronomo INT UNSIGNED NOT NULL,

    CONSTRAINT fk_visita_produtor
        FOREIGN KEY (idProdutor)
        REFERENCES Produtor(idProdutor),

    CONSTRAINT fk_visita_agronomo
        FOREIGN KEY (idAgronomo)
        REFERENCES Agronomo(idAgronomo)
);

